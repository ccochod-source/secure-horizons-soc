# TRACE — configuration locale. Copier vers .env et renseigner les valeurs.
# Ne jamais publier le .env ni ajouter NEXT_PUBLIC_ à une clé privée.

# Connexion Supabase utilisée côté serveur par GET /api/soc.
# URL du projet : https://<project-ref>.supabase.co (pas une chaîne PostgreSQL).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Compatibilité avec le .env déjà fourni par l’équipe :
# DATABASE_URL=https://<project-ref>.supabase.co/rest/v1/
# service_role_key=<clé privée>
# La passerelle accepte ces anciens noms si les variables SUPABASE_* sont absentes.
# Cette V0 Python accepte aussi cette URL REST dans DATABASE_URL.
DATABASE_URL=

# Backend agents — jamais envoyés au navigateur.
OPENAI_API_KEY=
OPENAI_MODEL=
# Clé réservée à l'agent RAG, utilisée côté serveur uniquement.
OPENAI_API_KEY_RAG=
RAG_MODEL=gpt-6-luna
GITGUARDIAN_API_KEY=
FRONTEND_ORIGIN=http://localhost:3100

# Futur raccordement de l’interface au backend d’Alex ; pas encore utilisé.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Agent développeur / passerelle locale (Python, port 8001).
# python -m victim_agent.cli init crée ces jetons dans .env.victim, ignoré par Git.
VICTIM_GATEWAY_TOKEN=
CONFINEMENT_TOKEN=
AGENT_MODEL=gpt-4.1-2025-04-14
ALEX_API_URL=http://127.0.0.1:8000
PASSERELLE_TOKEN=
VICTIM_RECEIVER_URL=http://127.0.0.1:8001/demo-receiver
# À copier dans la configuration du backend d'Alex :
# CONFINEMENT_URL=http://127.0.0.1:8001/confinement
# CONFINEMENT_TOKEN=<même jeton privé que .env.victim>
