# TRACE — configuration proposée pour le futur backend Python.
# Les noms devront être alignés avec le backend d'Alex.
# Ce modèle n'est pas chargé automatiquement par l'interface Next.js.
# Copier vers backend/.env lorsque ce dossier existe, puis compléter localement.
# Ne jamais publier le fichier .env contenant les vraies valeurs.

# Base PostgreSQL — chaîne de connexion fournie par Léon.
# Utiliser une identité avec les permissions nécessaires, pas un accès admin partagé.
DATABASE_URL=

# API IA — clé privée, uniquement côté backend.
OPENAI_API_KEY=
# À compléter avec le modèle choisi par l'équipe.
OPENAI_MODEL=

# Intégration GitGuardian facultative — clé privée, uniquement côté backend.
GITGUARDIAN_API_KEY=

# Origine du frontend local pour la configuration CORS du backend.
# CORS ne remplace pas l'authentification des routes sensibles.
FRONTEND_ORIGIN=http://localhost:3100
