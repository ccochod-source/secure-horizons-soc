# TRACE — configuration locale. Copier vers .env et renseigner les valeurs.
# Ne jamais publier le .env ni ajouter NEXT_PUBLIC_ à une clé privée.

# Connexion Supabase utilisée côté serveur par GET /api/soc.
# URL du projet : https://<project-ref>.supabase.co (pas une chaîne PostgreSQL).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Compatibilité avec le .env déjà fourni par l’équipe :
# DATABASE_URL=https://<project-ref>.supabase.co/rest/v1/
# service_role_key=<clé privée>
# La passerelle accepte ces anciens noms si les variables SUPABASE_* sont absentes.
# Le backend Python (backend/) exige une vraie chaîne PostgreSQL :
# postgresql://postgres.<project-ref>:<mot de passe>@<hôte du pooler>:6543/postgres
# Dans ce cas, renseigner aussi SUPABASE_URL ci-dessus pour l'interface.
DATABASE_URL=

# Passerelle de traçage (backend/). Optionnels.
# Si GATEWAY_TOKEN est défini, les routes exigent « Authorization: Bearer <jeton> ».
GATEWAY_TOKEN=
# Serveurs MCP réels à relayer, séparés par des virgules (Streamable HTTP).
MCP_UPSTREAM_URLS=

# Futur backend agents — jamais envoyés au navigateur.
OPENAI_API_KEY=
OPENAI_MODEL=
GITGUARDIAN_API_KEY=
FRONTEND_ORIGIN=http://localhost:3100

# Futur raccordement au backend d’Alex ; pas encore utilisé.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
