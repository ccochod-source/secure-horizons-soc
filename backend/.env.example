# Copier ce fichier en .env (dans le dossier backend/) puis compléter.
# Le fichier .env n'est jamais envoyé sur GitHub (il est dans .gitignore).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FRONTEND_ORIGIN=http://localhost:3100
# Mettre 1 pour tester sans clé OpenAI (l'enquêteur renvoie une réponse fixe).
MOCK_LLM=0

# Base Supabase de l'équipe. Dans Supabase : bouton « Connect » > « Session pooler » > copier la chaîne,
# et remplacer [YOUR-PASSWORD] par le mot de passe de la base (demander à Léon).
# Mieux : la ranger dans les secrets Codespaces sous le nom DATABASE_URL, comme la clé OpenAI.
# Vide = fichier SQLite local (trace.sqlite), pour tester sans réseau.
DATABASE_URL=
# Schéma où le backend range ses tables dans Supabase (non exposé par l'API publique).
DATABASE_SCHEMA=trace

# Exécution réelle du confinement : adresse de la passerelle (proxy d'Elyott) qui applique l'action approuvée.
# Vide = rien n'est exécuté, l'incident reste « Approuvé, en attente d'exécution » jusqu'à confirmation
# de la passerelle sur POST /incidents/{id}/execution.
CONFINEMENT_URL=
CONFINEMENT_TOKEN=
# Jetons d'accès au backend (vides = routes ouvertes, uniquement pour tester en local).
# La passerelle envoie « Authorization: Bearer <PASSERELLE_TOKEN> » sur /events et /execution.
# L'interface envoie « Authorization: Bearer <ANALYSTE_TOKEN> » sur /incidents et /decision.
PASSERELLE_TOKEN=
ANALYSTE_TOKEN=
