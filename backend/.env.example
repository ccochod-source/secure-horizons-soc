# Copier ce fichier en .env (dans le dossier backend/) puis compléter.
# Le fichier .env n'est jamais envoyé sur GitHub (il est dans .gitignore).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FRONTEND_ORIGIN=http://localhost:3100
# Mettre 1 pour tester sans clé OpenAI (l'enquêteur renvoie une réponse fixe).
MOCK_LLM=0
